{
  "info": {
    "name": "Toca Aqui - API Completa",
    "description": "Coleção completa de endpoints do backend Toca Aqui.\n\n**Main API**: http://localhost:3000\n**Social Service**: http://localhost:3001\n\n**Como usar:**\n1. Faça login em POST /usuarios/login\n2. Copie o token da resposta\n3. Cole na variável de coleção `token`\n4. Ajuste os IDs nas variáveis conforme necessário",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "socialUrl", "value": "http://localhost:3001", "type": "string" },
    { "key": "token", "value": "SEU_JWT_AQUI", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "artistaId", "value": "1", "type": "string" },
    { "key": "estabelecimentoId", "value": "1", "type": "string" },
    { "key": "bandaId", "value": "1", "type": "string" },
    { "key": "agendamentoId", "value": "1", "type": "string" },
    { "key": "eventoId", "value": "1", "type": "string" },
    { "key": "contratoId", "value": "1", "type": "string" },
    { "key": "pagamentoId", "value": "1", "type": "string" },
    { "key": "notificacaoId", "value": "1", "type": "string" },
    { "key": "enderecoId", "value": "1", "type": "string" },
    { "key": "ingressoId", "value": "1", "type": "string" },
    { "key": "showId", "value": "1", "type": "string" },
    { "key": "comentarioId", "value": "1", "type": "string" },
    { "key": "avaliacaoId", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / - Root",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "GET /health - Main API",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "GET /health - Social Service",
          "request": {
            "method": "GET",
            "url": "{{socialUrl}}/health",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "POST /registro",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/usuarios/registro",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome_completo\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"senha\": \"Senha@123\",\n  \"tipo_usuario\": \"common_user\"\n}"
            }
          }
        },
        {
          "name": "POST /login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/usuarios/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@email.com\",\n  \"senha\": \"Senha@123\"\n}"
            }
          }
        },
        {
          "name": "POST /logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/usuarios/logout"
          }
        },
        {
          "name": "POST /esqueci-senha",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/usuarios/esqueci-senha",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@email.com\"\n}"
            }
          }
        },
        {
          "name": "POST /redefinir-senha",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/usuarios/redefinir-senha",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_DO_EMAIL\",\n  \"nova_senha\": \"NovaSenha@123\"\n}"
            }
          }
        },
        {
          "name": "GET /verificar-email",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/usuarios/verificar-email?token=TOKEN_DO_EMAIL",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "verificar-email"],
              "query": [{ "key": "token", "value": "TOKEN_DO_EMAIL" }]
            }
          }
        },
        {
          "name": "GET /perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/perfil"
          }
        },
        {
          "name": "GET /minhas-paginas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/minhas-paginas"
